{"version":3,"kind":"Article","sha256":"953c5493af139ab0280246cf19ec1ee8abd2cab98300e60fb7652fcc24e78699","slug":"open-catalyst-project","location":"/catalysts/open_catalyst_project.md","dependencies":[],"frontmatter":{"title":"Open Catalyst Project","content_includes_title":false,"authors":[{"nameParsed":{"literal":"FAIR Chemistry & Collaborators","given":"FAIR Chemistry &","family":"Collaborators"},"name":"FAIR Chemistry & Collaborators","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/facebookresearch/fairchem","copyright":"Meta Platforms, Inc","numbering":{"title":{"offset":2}},"source_url":"https://github.com/facebookresearch/fairchem/blob/main/docs/catalysts/open_catalyst_project.md","edit_url":"https://github.com/facebookresearch/fairchem/edit/main/docs/catalysts/open_catalyst_project.md","exports":[{"format":"md","filename":"open_catalyst_project.md","url":"/fairchem/_public/open_catalyst_projec-859a4e3e155d59854f3526d0a329890c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Overview","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cFsbJTZ5P5"}],"identifier":"overview","label":"Overview","html_id":"overview","implicit":true,"key":"CqfLMeUCQ9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The Open Catalyst Project was a collaborative research effort between\nFundamental AI Research (FAIR) at Meta and Carnegie Mellon University’s (CMU)\nDepartment of Chemical Engineering. The aim was to use AI to model and discover\nnew catalysts for use in renewable energy storage to help in addressing climate\nchange.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"aQD4qj8jdu"}],"key":"aIYnUDlcQl"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Scalable and cost-effective solutions to renewable energy storage are essential\nto addressing the world’s rising energy needs while reducing climate change. As\nwe increase our reliance on renewable energy sources such as wind and solar,\nwhich produce intermittent power, storage is needed to transfer power from times\nof peak generation to peak demand. This may require the storage of power for\nhours, days, or months. One solution that offers the potential of scaling to\nnation-sized grids is the conversion of renewable energy to other fuels, such as\nhydrogen. To be widely adopted, this process requires cost-effective solutions to\nrunning chemical reactions.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"ykGd3zHtko"}],"key":"H2E3EyhiRZ"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"An open challenge is finding low-cost catalysts to drive these reactions at high\nrates. Through the use of quantum mechanical simulations (density functional\ntheory), new catalyst structures can be tested and evaluated. Unfortunately, the\nhigh computational cost of these simulations limits the number of structures\nthat may be tested. The use of AI or machine learning may provide a method to\nefficiently approximate these calculations, leading to new approaches in finding\neffective catalysts.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"mvVWuSHfs6"}],"key":"ASOEaZlq5Q"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"To enable the broader research community to participate in the project, we\nreleased the ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"z3JtaabbOO"},{"type":"link","url":"/oc20-1","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Open Catalyst 2020 (OC20)","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"wlIZfYqDt7"}],"urlSource":"datasets/oc20.md","dataUrl":"/oc20-1.json","internal":true,"protocol":"file","key":"Erk11qygI3"},{"type":"text","value":" and\n","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"SzVDlxX4xw"},{"type":"link","url":"/oc22","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Open Catalyst 2022 (OC22)","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"uRp01kwni3"}],"urlSource":"datasets/oc22.md","dataUrl":"/oc22.json","internal":true,"protocol":"file","key":"eFGYbiUvbv"},{"type":"text","value":" datasets for training ML models.\nTogether, these releases contained 1.3 million molecular relaxations with results\nfrom over 260 million DFT calculations. In addition to the data, baseline models\nand code were open-sourced on\n","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"pXGAy5p24o"},{"type":"link","url":"https://github.com/facebookresearch/fairchem","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"our GitHub page","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"NKyd7Vb5Rn"}],"urlSource":"https://github.com/facebookresearch/fairchem","error":true,"key":"Iv8s6gQiyC"},{"type":"text","value":". Results are\navailable on the\n","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"cuzVRdKdDs"},{"type":"link","url":"https://huggingface.co/spaces/facebook/fairchem_leaderboard","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"leaderboard","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Le2ihVOsuh"}],"urlSource":"https://huggingface.co/spaces