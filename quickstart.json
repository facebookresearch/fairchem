"lang":"python","value":"from ase.build import fcc100, add_adsorbate, molecule\nfrom ase.optimize import LBFGS\nfrom fairchem.core import pretrained_mlip, FAIRChemCalculator\n\npredictor = pretrained_mlip.get_predict_unit(\"uma-s-1p2\", device=\"cuda\")\ncalc = FAIRChemCalculator(predictor, task_name=\"oc20\")\n\n# Set up your system as an ASE atoms object\nslab = fcc100(\"Cu\", (3, 3, 3), vacuum=8, periodic=True)\nadsorbate = molecule(\"CO\")\nadd_adsorbate(slab, adsorbate, 2.0, \"bridge\")\n\nslab.calc = calc\n\n# Set up LBFGS dynamics object\nopt = LBFGS(slab)\nopt.run(0.05, 100)","position":{"start":{"line":175,"column":1},"end":{"line":193,"column":1}},"key":"s71C2oflnU"},{"type":"heading","depth":2,"position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"Relax an inorganic crystal","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"dlYLBgH9Ok"}],"identifier":"relax-an-inorganic-crystal","label":"Relax an inorganic crystal","html_id":"relax-an-inorganic-crystal","implicit":true,"key":"STDdpLOXlZ"},{"type":"code","lang":"python","value":"from ase.build import bulk\nfrom ase.optimize import FIRE\nfrom ase.filters import FrechetCellFilter\nfrom fairchem.core import pretrained_mlip, FAIRChemCalculator\n\npredictor = pretrained_mlip.get_predict_unit(\"uma-s-1p2\", device=\"cuda\")\ncalc = FAIRChemCalculator(predictor, task_name=\"omat\")\n\natoms = bulk(\"Fe\")\natoms.calc = calc\n\nopt = LBFGS(FrechetCellFilter(atoms))\nopt.run(0.05, 100)","position":{"start":{"line":197,"column":1},"end":{"line":211,"column":1}},"key":"Wylzq7dDQJ"},{"type":"heading","depth":2,"position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"text","value":"Run molecular MD","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"pKgPVYbvrN"}],"identifier":"run-molecular-md","label":"Run molecular MD","html_id":"run-molecular-md","implicit":true,"key":"xFYbewSjzj"},{"type":"code","lang":"python","value":"from ase import units\nfrom ase.io import Trajectory\nfrom ase.md.langevin import Langevin\nfrom ase.build import molecule\nfrom fairchem.core import pretrained_mlip, FAIRChemCalculator\n\npredictor = pretrained_mlip.get_predict_unit(\"uma-s-1p2\", device=\"cuda\")\ncalc = FAIRChemCalculator(predictor, task_name=\"omol\")\n\natoms = molecule(\"H2O\")\natoms.calc = calc\n\ndyn = Langevin(\n    atoms,\n    timestep=0.1 * units.fs,\n    temperature_K=400,\n    friction=0.001 / units.fs,\n)\ntrajectory = Trajectory(\"my_md.traj\", \"w\", atoms)\ndyn.attach(trajectory.write, interval=1)\ndyn.run(steps=1000)","position":{"start":{"line":215,"column":1},"end":{"line":237,"column":1}},"key":"tGV0OCx6rO"},{"type":"heading","depth":2,"position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"text","value":"Calculate a spin gap","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"key":"Q8SZBvfqIX"}],"identifier":"calculate-a-spin-gap","label":"Calculate a spin gap","html_id":"calculate-a-spin-gap","implicit":true,"key":"eoXrSFbr6C"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"L3tGufpbDx"}],"key":"lNLg6vbPOX"},{"type":"paragraph","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"children":[{"type":"text","value":"For molecular systems using the ","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"OkIpTQ1E4a"},{"type":"inlineCode","value":"omol","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"GnmBnkil3l"},{"type":"text","value":" task, you can specify charge and spin multiplicity via the ","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"OPWWVy8TE1"},{"type":"inlineCode","value":"atoms.info","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"RDd7NTwlHo"},{"type":"text","value":" dictionary. This is important for modeling charged or open-shell systems.","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"eU6P2OlqSj"}],"key":"HhWkEoW374"}],"key":"Rgknfx4GFR"},{"type":"code","lang":"python","value":"from ase.build import molecule\nfrom fairchem.core import pretrained_mlip, FAIRChemCalculator\n\npredictor = pretrained_mlip.get_predict_unit(\"uma-s-1p2\", device=\"cuda\")\n\n#  singlet CH2\nsinglet = molecule(\"CH2_s1A1d\")\nsinglet.info.update({\"spin\": 1, \"charge\": 0})\nsinglet.calc = FAIRChemCalculator(predictor, task_name=\"omol\")\n\n#  triplet CH2\ntriplet = molecule(\"CH2_s3B1d\")\ntriplet.info.update({\"spin\": 3, \"charge\": 0})\ntriplet.calc = FAIRChemCalculator(predictor, task_name=\"omol\")\n\ntriplet.get_potential_energy() - singlet.get_potential_energy()","position":{"start":{"line":245,"column":1},"end":{"line":262,"column":1}},"key":"pKUz3wXACS"}],"key":"ZwWUI34eib"}],"key":"vyQgNtONLX"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Installation & License","url":"/install","group":"Quickstart"},"next":{"title":"fairchem>=2.0","url":"/fairchemv1-v2","group":"Quickstart"}}},"domain":"http://localhost:3000"}