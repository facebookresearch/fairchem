culate import FAIRChemCalculator, InferenceBatcher\n\n# Create a predict unit\npredict_unit = pretrained_mlip.get_predict_unit(\"uma-s-1p2p1\")\n\n# Wrap it with InferenceBatcher\nbatcher = InferenceBatcher(\n    predict_unit, concurrency_backend_options=dict(max_workers=32)\n)","position":{"start":{"line":53,"column":1},"end":{"line":64,"column":1}},"key":"soleg8LsGZ"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Tip","key":"Tegt8fa1KM"}],"key":"rqe66g53Yf"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"kz1DVgpiDQ"},{"type":"inlineCode","value":"max_workers","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"sNOhQZsinf"},{"type":"text","value":" parameter controls how many concurrent simulations can run concurrently. Adjust this based on your system’s memory and the size of your structures.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"bbxsl7zo4m"}],"key":"icn7xuwPaG"}],"key":"Z78SHZfD9s"},{"type":"heading","depth":2,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Writing Simulation Functions","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"Yd2oVxsj2H"}],"identifier":"writing-simulation-functions","label":"Writing Simulation Functions","html_id":"writing-simulation-functions","implicit":true,"key":"ebOZ45YQ4U"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"The only requirement for using ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"iTRG04dHvf"},{"type":"inlineCode","value":"InferenceBatcher","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"lXAobQgV8k"},{"type":"text","value":" is to write your simulation logic as a function that takes an ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"AAkvSUBhUo"},{"type":"inlineCode","value":"Atoms","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"phQrjqgMok"},{"type":"text","value":" object and a predict unit as arguments:","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"hXdW4pPXKx"}],"key":"uQCopgzGGn"},{"type":"code","lang":"python","value":"from ase.build import bulk\nfrom ase.filters import FrechetCellFilter\nfrom ase.optimize import LBFGS\n\n\ndef run_relaxation(atoms, predict_unit):\n    \"\"\"Run a structure relaxation and return the final energy.\"\"\"\n    calc = FAIRChemCalculator(predict_unit, task_name=\"omat\")\n    atoms.calc = calc\n    opt = LBFGS(FrechetCellFilter(atoms), logfile=None)\n    opt.run(fmax=0.02, steps=100)\n    return atoms.get_potential_energy()","position":{"start":{"line":74,"column":1},"end":{"line":87,"column":1}},"key":"QD3Xdi23si"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Running Batched Relaxations","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"ZNwCAIESji"}],"identifier":"running-batched-relaxations","label":"Running Batched Relaxations","html_id":"running-batched-relaxations","implicit":true,"key":"XAAaoCs6bV"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Once you have your simulation function, you can run it in batched mode using the executor’s ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"MvTDxOFqX7"},{"type":"inlineCode","value":"map","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"enaTMmaxwK"},{"type":"text","value":" or ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"XXmmw4icHl"},{"type":"inlineCode","value":"submit","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"ryl2aS7X6H"},{"type":"text","value":" methods:","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"Bavs0wRgDj"}],"key":"Z1dcKefs8e"},{"type":"heading","depth":3,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Using ","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"tq5u5EEVM1"},{"type":"inlineCode","value":"executor.map","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"xLaHfwYE96"}],"identifier":"using-executor-map","label":"Using executor.map","html_id":"using-executor-map","implicit":true,"key":"iQL1EUzlr8"},{"type":"code","lang":"python","value":"from functools import partial\n\n# Create a list of structures to relax\nprim_atoms = [\n    bulk(\"Cu\"),\n    bulk(\"MgO\", \"rocksalt\", a=4.2),\n    bulk(\"Si\", \"diamond\", a=5.43),\n    bulk(\"NaCl\", \"rocksalt\", a=3.8),\n]\n\natoms_list = [make_supercell(atoms, 3 * np.identity(3)) for atoms in prim_atoms]\n\nfor atoms in atoms_list:\n    atoms.rattle(0.1)\n\n# Create a partial function with the batch predict unit\nrun_relaxation_batched = partial(\n    run_relaxation, predict_unit=batcher.batch_predict_unit\n)\n\n# Run all relaxations in parallel with batched inference\nrelaxed_energies = list(batcher.executor.map(run_relaxation_batched, atoms_list))","position":{"start":{"line":95,"column":1},"end":{"line":118,"column":1}},"key":"gQl59TSmtz"},{"type":"heading","depth":3,"position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"Using ","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"vwGsiBBkiU"},{"type":"inlineCode","value":"executor.submit","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"vhhxxypz70"},{"type":"text","value":" for more control","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"TtPA3p1dE9"}],"identifier":"using-executor-submit-for-more-control","label":"Using executor.submit for more control","html_id":"using-executor-submit-for-more-control","implicit":true,"key":"WULyWBRmqe"},{"type":"paragraph","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"If you need more control over the execution or want to process results as they complete:","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"gx9C4Atd4p"}],"key":"O7WvEuLYft"},{"type":"code","lang":"python","value":"# Create a new list of structures to relax\natoms_list = [make_supercell(atoms, 3 * np.identity(3)) for atoms in prim_atoms]\n\nfor atoms in atoms_list:\n    atoms.rattle(0.1)\n\n# Submit all jobs\nfutures = [\n    batcher.executor.submit(run_relaxation, atoms, batcher.batch_predict_unit)\n    for atoms in atoms_list\n]\n\n# Collect results\nrelaxed_energies = [future.result() for future in futures]","position":{"start":{"line":124,"column":1},"end":{"line":139,"column":1}},"key":"YSyHgDbRxv"},{"type":"heading","depth":2,"position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"Running Batched Molecular Dynamics","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"pgQjWIVcaM"}],"identifier":"running-batched-molecular-dynamics","label":"Running Batched Molecular Dynamics","html_id":"running-batched-molecular-dynamics","implicit":true,"key":"VqBoHOMu7x"},{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"The same pattern works for molecular dynamics simulations:","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"Yv7Rfx8tu9"}],"key":"fW9NZ54a8y"},{"type":"code","lang":"python","value":"from ase import units\nfrom ase.md.langevin import Langevin\nfrom ase.md.velocitydistribution import MaxwellBoltzmannDistribution\n\n\ndef run_nvt_md(atoms, predict_unit, temperature, traj_fname):\n    \"\"\"Run NVT molecular dynamics simulation.\"\"\"\n    calc = FAIRChemCalculator(predict_unit, task_name=\"omat\")\n    atoms.calc = calc\n    MaxwellBoltzmannDistribution(atoms, temperature, force_temp=True)\n    dyn = Langevin(\n        atoms,\n        timestep=2 * units.fs,\n        temperature_K=temperature,\n        friction=0.1,\n        trajectory=traj_fname,\n        loginterval=5,\n    )\n    dyn.run(100)\n\n\n# Run batched MD simulations\nrun_md_batched = partial(\n    run_nvt_md, predict_unit=batcher.batch_predict_unit, temperature=300\n)\n\nfutures = [\n    batcher.executor.submit(run_md_batched, atoms, traj_fname=f\"traj_{i}.traj\")\n    for i, atoms in enumerate(atoms_list)\n]\n\n# Wait for all simulations to complete\n[future.result() for future in futures]","position":{"start":{"line":145,"column":1},"end":{"line":179,"column":1}},"key":"SRGPXamPpL"},{"type":"heading","depth":2,"position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"children":[{"type":"text","value":"When to Use InferenceBatcher","position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"IpKgzJ0ZFV"}],"identifier":"when-to-use-inferencebatcher","label":"When to Use InferenceBatcher","html_id":"when-to-use-inferencebatcher","implicit":true,"key":"gLPZoZngZe"},{"type":"paragraph","position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"children":[{"type":"inlineCode","value":"InferenceBatcher","position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"key":"moLMeme9mM"},{"type":"text","value":" is most beneficial when:","position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"key":"Lpgb40yRtx"}],"key":"jW9gsSbrIo"},{"type":"list","ordered":false,"